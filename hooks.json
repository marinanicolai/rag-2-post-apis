{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_git.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_git.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
